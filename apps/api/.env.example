DATABASE_URL="postgresql://agritrack:agritrack@localhost:5433/agritrack?schema=public"
# En producción: valor aleatorio de al menos 32 caracteres (la API no arranca sin él).
JWT_SECRET="contraseña"
JWT_EXPIRES_IN="1d"
PORT=3001

# Producción: NODE_ENV=production y CORS_ORIGIN con el dominio de la web
# (varios separados por comas). Sin CORS_ORIGIN la API no arranca en producción.
# NODE_ENV=production
# CORS_ORIGIN="https://agritrack.example.com"

AGROAN_CONTACTO_NOMBRE="AgroAn"
AGROAN_CONTACTO_TELEFONO="+591 70000000"
AGROAN_CONTACTO_EMAIL="contacto@agroan.com"
