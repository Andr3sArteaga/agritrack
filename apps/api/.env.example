DATABASE_URL="postgresql://agritrack:agritrack@localhost:5433/agritrack?schema=public"
# Para Supabase en producción (conexión directa sin pooler para Prisma migrate):
# DIRECT_URL="postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres"

# En producción: valor aleatorio de al menos 32 caracteres (la API no arranca sin él).
JWT_SECRET="contraseña"
JWT_EXPIRES_IN="1d"
PORT=3001

# Producción: NODE_ENV=production y CORS_ORIGIN con el dominio de la web
# (varios separados por comas). Sin CORS_ORIGIN la API no arranca en producción.
# NODE_ENV=production
# CORS_ORIGIN="https://agritrack.example.com"
# FRONTEND_URL="https://agritrack.example.com"

# Integración con Supabase Auth (recuperación de contraseña / sincronización de usuarios)
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Envío de correos transaccionales (aprobación de cuentas y recuperación alternativa)
# RESEND_API_KEY=""
# MAIL_FROM="AgriTrack <noreply@agroan.com>"

AGROAN_CONTACTO_NOMBRE="AgroAn"
AGROAN_CONTACTO_TELEFONO="+591 70000000"
AGROAN_CONTACTO_EMAIL="contacto@agroan.com"
