// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =========================================
// Enums
// =========================================

enum Rol {
  JEFE
  CONTABILIDAD
  OPERATIVO
}

enum EstadoUsuario {
  PENDIENTE
  ACTIVO
}

enum EstadoCampana {
  PLANIFICADA
  EN_CURSO
  COSECHADA
}

enum TipoActividad {
  SIEMBRA
  FUMIGACION
  FERTILIZACION
  MEDICION_HUMEDAD_SUELO
  MEDICION_HUMEDAD_GRANO
  COSECHA
}

enum CondicionClima {
  SOLEADO
  NUBLADO
  LLUVIA_LIGERA
  LLUVIA_FUERTE
  HELADA
  GRANIZO
  VIENTO_FUERTE
}

enum TipoContacto {
  COMPRADOR
  TRANSPORTISTA
  MAQUINARIA
  INSUMOS
  SERVICIOS
  OTRO
}

enum TipoInsumo {
  SEMILLA
  FERTILIZANTE
  AGROQUIMICO
  COMBUSTIBLE
}

enum CategoriaGasto {
  INSUMOS
  SERVICIO_TERCERIZADO
  MAQUINARIA
  MANO_DE_OBRA
  OTROS
}

enum EstadoGasto {
  PAGADO
  COMPROMETIDO
}

// =========================================
// Modelos
// =========================================

model Usuario {
  id           String        @id @default(cuid())
  nombre       String
  apellido     String?
  email        String        @unique
  telefono     String?
  passwordHash String
  rol          Rol
  estado       EstadoUsuario @default(ACTIVO)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  actividadesRegistradas Actividad[]     @relation("ResponsableActividad")
  gastosRegistrados      Gasto[]         @relation("RegistradoPorGasto")
  analisisSuelo          AnalisisSuelo[]
  registrosClima         RegistroClima[]
  fotosParcela           FotoParcela[]

  @@index([estado])
  @@map("usuarios")
}

model Parcela {
  id                     String   @id @default(cuid())
  nombre                 String
  hectareas              Float
  ubicacionTexto         String
  lat                    Float?
  lng                    Float?
  disponibleParaPreventa Boolean  @default(false)
  activa                 Boolean  @default(true)
  // GeoJSON Polygon ([lng, lat]). Las hectareas se derivan de este poligono
  // en el service (turf.area), nunca del valor enviado por el cliente.
  poligono               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  campanas       Campana[]
  analisisSuelo  AnalisisSuelo[]
  registrosClima RegistroClima[]
  fotos          FotoParcela[]

  @@index([disponibleParaPreventa])
  @@index([activa])
  @@map("parcelas")
}

model Cultivo {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campanas       Campana[]
  totalesCampana TotalCampana[]
  modelosIa      ModeloIa[]

  @@map("cultivos")
}

model Campana {
  id          String        @id @default(cuid())
  parcelaId   String
  parcela     Parcela       @relation(fields: [parcelaId], references: [id], onDelete: Restrict)
  cultivoId   String
  cultivo     Cultivo       @relation(fields: [cultivoId], references: [id])
  temporada   String
  fechaInicio DateTime
  fechaFin    DateTime?
  estado      EstadoCampana @default(PLANIFICADA)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  actividades     Actividad[]
  gastos          Gasto[]
  presupuesto     Presupuesto?
  // Solo la relacion inversa: la tabla campanas no cambia (la FK vive en registros_cosecha).
  registroCosecha RegistroCosecha?

  // Regla de negocio "solo una EN_CURSO por parcela" se valida en el
  // service (CampanasService) antes de crear/actualizar el estado.
  @@index([parcelaId])
  @@index([cultivoId])
  @@index([estado])
  @@map("campanas")
}

model Actividad {
  id                  String        @id @default(cuid())
  secuencia           Int           @unique @default(autoincrement())
  campanaId           String
  campana             Campana       @relation(fields: [campanaId], references: [id], onDelete: Restrict)
  tipo                TipoActividad
  fecha               DateTime
  descripcion         String
  insumo              String?
  cantidad            Float?
  unidad              String?
  responsableId       String
  responsable         Usuario       @relation("ResponsableActividad", fields: [responsableId], references: [id])
  tercerizado         Boolean       @default(false)
  maquinariaUtilizada String?
  rendimientoTnHa     Float?

  // Correcciones: una actividad no se edita ni borra; una correccion es un
  // nuevo registro que referencia a la actividad original. Una actividad
  // con al menos una correccion apuntandole deja de ser "vigente".
  correccionDeId   String?
  correccionDe     Actividad?  @relation("CorreccionDeActividad", fields: [correccionDeId], references: [id])
  correcciones     Actividad[] @relation("CorreccionDeActividad")
  motivoCorreccion String?

  // Cadena de integridad: hash = SHA-256(contenido canonico + hashAnterior),
  // canonicalizado en orden fijo (secuencia, campanaId, tipo, fecha,
  // descripcion, insumo, cantidad, unidad, responsableId, tercerizado,
  // maquinariaUtilizada, rendimientoTnHa, correccionDeId, motivoCorreccion,
  // hashAnterior). hashAnterior apunta al hash del registro con secuencia
  // inmediatamente anterior (cadena global); null solo en secuencia = 1.
  // La insercion corre dentro de una transaccion con
  // pg_advisory_xact_lock para evitar que dos inserciones concurrentes
  // tomen el mismo hashAnterior.
  hash         String
  hashAnterior String?

  createdAt DateTime @default(now())

  @@index([campanaId])
  @@index([responsableId])
  @@index([tipo])
  @@map("actividades")
}

model Contacto {
  id        String       @id @default(cuid())
  tipo      TipoContacto
  nombre    String
  empresa   String?
  telefono  String?
  email     String?
  notas     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tipo])
  @@map("contactos")
}

// ---------- Costos (RF-26 a RF-30). Montos en Bs. ----------

// Catalogo de insumos (RF-26). El precio NO vive aqui: el precio vigente es
// el ultimo PrecioInsumo con vigenteDesde <= fecha consultada.
model Insumo {
  id        String     @id @default(cuid())
  nombre    String     @unique
  tipo      TipoInsumo
  unidad    String
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  precios PrecioInsumo[]
  gastos  Gasto[]

  @@index([tipo])
  @@map("insumos")
}

// Historial de precios unitarios (RF-26): una fila por cambio de precio.
model PrecioInsumo {
  id           String   @id @default(cuid())
  insumoId     String
  insumo       Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  precio       Float
  vigenteDesde DateTime
  createdAt    DateTime @default(now())

  @@index([insumoId, vigenteDesde])
  @@map("precios_insumo")
}

// Gasto de una campana (RF-27). Nunca se borra: se anula con motivo (RF-56)
// y los anulados no cuentan en los totales. Fuera de la cadena de integridad.
model Gasto {
  id              String         @id @default(cuid())
  campanaId       String
  campana         Campana        @relation(fields: [campanaId], references: [id], onDelete: Restrict)
  categoria       CategoriaGasto
  descripcion     String
  monto           Float
  fecha           DateTime
  estado          EstadoGasto
  // Solo cuando el gasto es de un insumo del catalogo: cantidad y precio
  // unitario (copia del vigente al registrar) con los que se calculo el monto.
  insumoId        String?
  insumo          Insumo?        @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  cantidad        Float?
  precioUnitario  Float?
  registradoPorId String
  registradoPor   Usuario        @relation("RegistradoPorGasto", fields: [registradoPorId], references: [id])
  anulado         Boolean        @default(false)
  motivoAnulacion String?
  anuladoEn       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([campanaId, anulado])
  @@index([estado])
  @@index([insumoId])
  @@map("gastos")
}

// Presupuesto total de una campana (RF-29): uno por campana.
model Presupuesto {
  id         String   @id @default(cuid())
  campanaId  String   @unique
  campana    Campana  @relation(fields: [campanaId], references: [id], onDelete: Restrict)
  montoTotal Float
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("presupuestos")
}

// =========================================
// Estimacion de rendimiento (RF-31 a RF-35)
// =========================================

// Datos de siembra y cosecha por parcela y campana (una fila por campana).
// Es la fuente del modelo de rendimiento. No reemplaza a las actividades ni
// participa en la cadena de hashes. origen: "demo_enmascarado" | "real".
model RegistroCosecha {
  id           String    @id @default(cuid())
  campanaId    String    @unique
  campana      Campana   @relation(fields: [campanaId], references: [id], onDelete: Restrict)
  variedad     String?
  fechaSiembra DateTime?
  fechaCosecha DateTime?
  haSembradas  Float
  haCosechadas Float?
  toneladas    Float?
  origen       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([origen])
  @@map("registros_cosecha")
}

// Rendimiento total de una campana de un cultivo (toneladas totales /
// hectareas cosechadas totales). Es la base de la linea base oficial.
// rendimientoTotalTnHa null = la superficie total no se conoce: esa campana
// no entra en la linea base.
model TotalCampana {
  id                   String   @id @default(cuid())
  cultivoId            String
  cultivo              Cultivo  @relation(fields: [cultivoId], references: [id])
  temporada            String
  rendimientoTotalTnHa Float?
  origen               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([cultivoId, temporada, origen])
  @@map("totales_campana")
}

// Versiones del modelo de rendimiento. estado: "experimental" (por defecto),
// "activo" o "archivado". origenDatos: "demo_enmascarado" | "real".
model ModeloIa {
  id                 String   @id @default(cuid())
  cultivoId          String
  cultivo            Cultivo  @relation(fields: [cultivoId], references: [id])
  version            Int
  origenDatos        String
  campanasUsadas     Json
  hashDatos          String
  predictores        Json
  categoriasVariedad Json
  medianaDiasSiembra Float?
  metricas           Json
  modelo             Json
  estado             String   @default("experimental")
  createdAt          DateTime @default(now())

  @@unique([cultivoId, version])
  @@index([cultivoId, estado])
  @@map("modelos_ia")
}

// =========================================
// Monitoreo de la parcela: suelo y clima (carga manual)
// =========================================

// Resultado de un analisis de suelo. Todos los valores son opcionales, pero
// el service exige al menos uno. Unidades: pH (0-14); N, P y K en ppm
// (mg/kg); materia organica y humedad en %.
model AnalisisSuelo {
  id              String   @id @default(cuid())
  parcelaId       String
  parcela         Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Restrict)
  fecha           DateTime
  ph              Float?
  nitrogeno       Float?
  fosforo         Float?
  potasio         Float?
  materiaOrganica Float?
  // Humedad del suelo en %, medida en campo (no viene del laboratorio).
  humedad         Float?
  notas           String?
  registradoPorId String
  registradoPor   Usuario  @relation(fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())

  @@index([parcelaId, fecha])
  @@map("analisis_suelo")
}

// Clima anotado a mano para un dia. Un registro por parcela y dia.
model RegistroClima {
  id              String         @id @default(cuid())
  parcelaId       String
  parcela         Parcela        @relation(fields: [parcelaId], references: [id], onDelete: Restrict)
  fecha           DateTime
  condicion       CondicionClima
  lluviaMm        Float?
  notas           String?
  registradoPorId String
  registradoPor   Usuario        @relation(fields: [registradoPorId], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([parcelaId, fecha])
  @@map("registros_clima")
}

// =========================================
// Fotos de parcela (comprimidas en Base64 Data URL; visibilidad en preventa)
// =========================================

model FotoParcela {
  id                String   @id @default(cuid())
  parcelaId         String
  parcela           Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  imagenData        String
  descripcion       String?
  visibleEnPreventa Boolean  @default(true)
  subidaPorId       String
  subidaPor         Usuario  @relation(fields: [subidaPorId], references: [id])
  createdAt         DateTime @default(now())

  @@index([parcelaId, createdAt])
  @@index([parcelaId, visibleEnPreventa])
  @@map("fotos_parcela")
}
